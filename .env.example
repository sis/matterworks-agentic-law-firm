# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# AI
# Optional: enables AI SDK / AI Gateway document triage in Convex actions.
AI_GATEWAY_API_KEY=
# Optional: provider/model slug, e.g. openai/gpt-5.5 or anthropic/claude-sonnet-4.6.
INTAKE_ANALYSIS_MODEL=openai/gpt-5.5
